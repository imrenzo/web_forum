# Server configuration. Load with: set -a && . ./.env.example && set +a
# (copy to .env and edit for anything beyond local development).

# Postgres connection string. Matches docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/web_forum?sslmode=disable

# HS256 signing key for JWTs. Required; the server refuses to start without it.
# This value is a local-development placeholder: generate your own (e.g. `openssl rand -hex 32`) for any real use.
JWT_SECRET=local-dev-only-change-me

# Optional
PORT=8080
# Comma-separated origins allowed by CORS (the client's URL)
CORS_ORIGINS=http://localhost:3000
